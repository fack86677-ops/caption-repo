{
  "version": 2,
  "routes": [
    {
      "src": "/pricing",
      "dest": "/static/pricing.html"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/",
      "dest": "/static/login.html"
    },
    {
      "src": "/(.*)",
      "dest": "/static/$1"
    }
  ]
}
